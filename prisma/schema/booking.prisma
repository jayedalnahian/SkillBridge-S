model Booking {
    id            String        @id @default(uuid())
    userId        String
    tutorId       String
    startDateTime DateTime
    endDateTime   DateTime
    status        BookingStatus @default(PENDING)
    price         Float
    duration      Float
    meetingLink   String
    cancelBy      UserRole?
    cancelReason  String?
    isDeleted     Boolean       @default(false)
    deletedAt     DateTime?
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    //relations
    User    User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    Tutor   Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    reviews Review[]

    @@index([userId], name: "booking_user_id_idx")
    @@index([tutorId], name: "booking_tutor_id_idx")
    @@index([isDeleted], name: "booking_is_deleted_idx")
    @@map("booking")
}