model Booking {
    id            String        @id @default(uuid())
    studentId     String
    tutorId       String
    startDateTime DateTime
    endDateTime   DateTime
    status        BookingStatus @default(PENDING)
    paymentStatus PaymentStatus @default(UNPAID)
    price         Float
    duration      Float
    meetingLink   String?
    cancelBy      UserRole?
    cancelReason  String?
    isDeleted     Boolean       @default(false)
    deletedAt     DateTime?
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    //relations
    Student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    Tutor   Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    reviews Review[]
    payment Payment?

    @@index([studentId], name: "booking_student_id_idx")
    @@index([tutorId], name: "booking_tutor_id_idx")
    @@index([isDeleted], name: "booking_is_deleted_idx")
    @@map("booking")
}
